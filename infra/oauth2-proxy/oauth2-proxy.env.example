# Generic OIDC example. Keep this file root-readable only in production.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://id.example.com/
OAUTH2_PROXY_CLIENT_ID=webnix
OAUTH2_PROXY_CLIENT_SECRET=replace-me
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64-secret
OAUTH2_PROXY_REDIRECT_URL=https://term.example.com/oauth2/callback
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_INSECURE_OIDC_SKIP_NONCE=false
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_HTTP_ADDRESS=127.0.0.1:4180
# forward_auth only; authenticated application traffic goes Caddy -> gateway.
OAUTH2_PROXY_UPSTREAMS=static://202
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=false
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=false
OAUTH2_PROXY_PASS_BASIC_AUTH=false
OAUTH2_PROXY_PASS_USER_HEADERS=false
OAUTH2_PROXY_COOKIE_NAME=__Host-webnix
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_REFRESH=1h
OAUTH2_PROXY_COOKIE_EXPIRE=12h
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
